{
  "name": "portfolio-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:content": "node scripts/check-content.mjs",
    "test:portfolio": "node --test src/utils/*.test.js",
    "build:tcgtracking-catalog": "node pokemon-tcg-tracker/scripts/build-tcgtracking-catalog.cjs",
    "refresh:tcgtracking-catalog": "node pokemon-tcg-tracker/scripts/fetch-all-pokemon-data.cjs && npm run build:tcgtracking-catalog"
  },
  "devDependencies": {
    "terser": "^5.44.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "highlight.js": "^11.11.1",
    "vite-plugin-static-copy": "^3.4.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    }
  },
  "allowScripts": {
    "@firebase/util@1.15.0": true,
    "protobufjs@7.6.4": true
  }
}
